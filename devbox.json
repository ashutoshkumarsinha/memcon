{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.3/.schema/devbox.schema.json",
  "packages": [
    "python@3.12",
    "gnupg@latest",
    "python312Packages.pytest@latest",
    "python312Packages.pytest-mock@latest",
    "python312Packages.pyinstaller@latest",
    "podman@latest",
    "gnumake@latest",
    "kiro-cli@latest",
    "zip@latest"
  ],
  "shell": {
    "scripts": {
      "test": [
        "pytest -v test_memcon.py"
      ],
      "build": [
        "./build.sh"
      ],
      "version": [
        "python memcon.py --version"
      ],
      "help": [
        "make help"
      ],
      "show-context": [
        "python memcon.py --show-context"
      ],
      "run-ollama": [
        "python memcon.py --provider ollama"
      ],
      "run-anthropic": [
        "python memcon.py --provider anthropic"
      ],
      "run-openai": [
        "python memcon.py --provider openai"
      ],
      "run-kiro": [
        "python memcon.py --provider kiro"
      ]
    }
  }
}
